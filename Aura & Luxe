<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AURA & LUXE — Perfumería Árabe & Alta Joyería</title>
  <!-- Google Fonts & FontAwesome Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    :root {
      --bg-dark: #0a0a0a;
      --bg-card: #141414;
      --gold-primary: #d4af37;
      --gold-hover: #f3e5ab;
      --text-light: #f5f5f5;
      --text-muted: #a0a0a0;
      --border-color: #262626;
      --whatsapp-green: #25D366;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Montserrat', sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-light);
      line-height: 1.6;
      padding-bottom: 80px;
    }

    h1, h2, h3, .brand-font {
      font-family: 'Cinzel', serif;
      letter-spacing: 1px;
    }

    /* Header & Navigation */
    header {
      background-color: rgba(10, 10, 10, 0.95);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(10px);
    }

    .header-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 15px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--gold-primary);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .admin-btn {
      background: transparent;
      border: 1px solid var(--gold-primary);
      color: var(--gold-primary);
      padding: 8px 16px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.85rem;
      transition: all 0.3s ease;
    }

    .admin-btn:hover {
      background: var(--gold-primary);
      color: var(--bg-dark);
    }

    /* Hero Banner */
    .hero {
      text-align: center;
      padding: 60px 20px;
      background: linear-gradient(180deg, rgba(212, 175, 55, 0.08) 0%, rgba(10, 10, 10, 1) 100%);
      border-bottom: 1px solid var(--border-color);
    }

    .hero h1 {
      font-size: 2.5rem;
      color: var(--gold-primary);
      margin-bottom: 10px;
    }

    .hero p {
      color: var(--text-muted);
      font-size: 1.1rem;
      max-width: 600px;
      margin: 0 auto 20px auto;
    }

    .social-links {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin-top: 15px;
    }

    .social-icon {
      color: var(--gold-primary);
      font-size: 1.3rem;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: all 0.3s ease;
    }

    .social-icon:hover {
      border-color: var(--gold-primary);
      background-color: rgba(212, 175, 55, 0.1);
      transform: translateY(-2px);
    }

    /* Main Container & Filters */
    .container {
      max-width: 1200px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .filter-bar {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin-bottom: 30px;
      flex-wrap: wrap;
    }

    .filter-btn {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      color: var(--text-light);
      padding: 10px 20px;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .filter-btn.active, .filter-btn:hover {
      border-color: var(--gold-primary);
      color: var(--gold-primary);
    }

    /* Product Grid */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 25px;
    }

    .product-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .product-card:hover {
      transform: translateY(-5px);
      border-color: var(--gold-primary);
    }

    .product-img {
      width: 100%;
      height: 260px;
      object-fit: cover;
      border-bottom: 1px solid var(--border-color);
    }

    .product-info {
      padding: 20px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .product-category {
      font-size: 0.75rem;
      text-transform: uppercase;
      color: var(--gold-primary);
      letter-spacing: 1px;
      margin-bottom: 5px;
    }

    .product-title {
      font-size: 1.1rem;
      margin-bottom: 10px;
    }

    .product-desc {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 15px;
      flex-grow: 1;
    }

    .product-price {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--gold-primary);
      margin-bottom: 15px;
    }

    .btn-buy {
      width: 100%;
      background-color: transparent;
      border: 1px solid var(--whatsapp-green);
      color: var(--whatsapp-green);
      padding: 10px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      transition: all 0.3s ease;
    }

    .btn-buy:hover {
      background-color: var(--whatsapp-green);
      color: #fff;
    }

    /* Admin Panel Modal */
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.85);
      z-index: 1000;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .modal-content {
      background: var(--bg-card);
      border: 1px solid var(--gold-primary);
      width: 100%;
      max-width: 600px;
      max-height: 90vh;
      overflow-y: auto;
      border-radius: 8px;
      padding: 30px;
      position: relative;
    }

    .close-modal {
      position: absolute;
      top: 15px;
      right: 20px;
      color: var(--text-muted);
      font-size: 1.5rem;
      cursor: pointer;
    }

    .form-group {
      margin-bottom: 15px;
    }

    .form-group label {
      display: block;
      margin-bottom: 5px;
      font-size: 0.85rem;
      color: var(--gold-primary);
    }

    .form-group input, .form-group textarea, .form-group select {
      width: 100%;
      padding: 10px;
      background: var(--bg-dark);
      border: 1px solid var(--border-color);
      color: #fff;
      border-radius: 4px;
    }

    .btn-save {
      background: var(--gold-primary);
      color: var(--bg-dark);
      border: none;
      padding: 12px;
      width: 100%;
      font-weight: bold;
      cursor: pointer;
      border-radius: 4px;
      margin-top: 10px;
    }

    /* Floating WhatsApp Button */
    .whatsapp-float {
      position: fixed;
      bottom: 25px;
      right: 25px;
      background-color: var(--whatsapp-green);
      color: white;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
      z-index: 99;
      text-decoration: none;
      transition: transform 0.3s ease;
    }

    .whatsapp-float:hover {
      transform: scale(1.1);
    }

    footer {
      text-align: center;
      padding: 30px 20px;
      border-top: 1px solid var(--border-color);
      color: var(--text-muted);
      font-size: 0.85rem;
      margin-top: 50px;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="header-container">
      <a href="#" class="logo">
        <i class="fa-solid fa-gem"></i> AURA & LUXE
      </a>
      <button class="admin-btn" onclick="openAdminModal()">
        <i class="fa-solid fa-lock"></i> Panel Admin
      </button>
    </div>
  </header>

  <!-- Hero Banner -->
  <section class="hero">
    <h1>AURA & LUXE</h1>
    <p>Fragancias Árabes Exclusivas & Alta Joyería Laminada 18K</p>
    
    <div class="social-links">
      <a href="#" id="link-instagram" target="_blank" class="social-icon"><i class="fa-brands fa-instagram"></i></a>
      <a href="#" id="link-tiktok" target="_blank" class="social-icon"><i class="fa-brands fa-tiktok"></i></a>
      <a href="#" id="link-facebook" target="_blank" class="social-icon"><i class="fa-brands fa-facebook"></i></a>
    </div>
  </section>

  <!-- Main Content -->
  <main class="container">
    <div class="filter-bar">
      <button class="filter-btn active" onclick="filterProducts('all')">Todos</button>
      <button class="filter-btn" onclick="filterProducts('perfume')">Perfumería Árabe</button>
      <button class="filter-btn" onclick="filterProducts('joyeria')">Joyería 18K</button>
    </div>

    <div class="product-grid" id="productGrid"></div>
  </main>

  <!-- WhatsApp Flotante -->
  <a href="#" id="floatingWhatsapp" target="_blank" class="whatsapp-float">
    <i class="fa-brands fa-whatsapp"></i>
  </a>

  <!-- Modal Admin Panel -->
  <div class="modal" id="adminModal">
    <div class="modal-content">
      <span class="close-modal" onclick="closeAdminModal()">×</span>
      <h2 style="color: var(--gold-primary); margin-bottom: 20px;">Panel de Administración</h2>
      
      <form id="adminForm" onsubmit="saveAdminSettings(event)">
        <h3 style="font-size: 1rem; margin: 15px 0 10px; border-bottom: 1px solid var(--border-color);">Configuración de Contacto</h3>
        <div class="form-group">
          <label>WhatsApp (Sin espacios, ej: 573001234567)</label>
          <input type="text" id="inputPhone" required>
        </div>
        <div class="form-group">
          <label>Enlace Instagram</label>
          <input type="url" id="inputInsta">
        </div>
        <div class="form-group">
          <label>Enlace TikTok</label>
          <input type="url" id="inputTikTok">
        </div>
        <div class="form-group">
          <label>Enlace Facebook</label>
          <input type="url" id="inputFB">
        </div>

        <h3 style="font-size: 1rem; margin: 20px 0 10px; border-bottom: 1px solid var(--border-color);">Agregar Nuevo Producto</h3>
        <div class="form-group">
          <label>Nombre del Producto</label>
          <input type="text" id="pName">
        </div>
        <div class="form-group">
          <label>Categoría</label>
          <select id="pCat">
            <option value="perfume">Perfumería Árabe</option>
            <option value="joyeria">Joyería 18K</option>
          </select>
        </div>
        <div class="form-group">
          <label>Precio (COP)</label>
          <input type="number" id="pPrice" placeholder="180000">
        </div>
        <div class="form-group">
          <label>Descripción Corta</label>

          <textarea id="pDesc" rows="3"></textarea>
        </div>
        <div class="form-group">
          <label>URL de Imagen</label>
          <input type="url" id="pImg" placeholder="https://images.unsplash.com/...">
        </div>

        <button type="submit" class="btn-save">Guardar Cambios</button>
      </form>
    </div>
  </div>

  <footer>
    <p>© 2026 AURA & LUXE — Todos los derechos reservados.</p>
  </footer>

  <script>
    // Configuración Inicial Predeterminada
    const DEFAULT_SETTINGS = {
      phone: "573000000000",
      instagram: "https://instagram.com",
      tiktok: "https://tiktok.com",
      facebook: "https://facebook.com"
    };

    const DEFAULT_PRODUCTS = [
      {
        id: 1,
        title: "Chifon Belle — Emper",
        category: "perfume",
        price: 180000,
        desc: "Chifon Belle abre con una jugosa frescura frutal, evoluciona hacia un delicado corazón floral y culmina en un cálido fondo dulce y goloso.",
        img: "https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?w=500&auto=format&fit=crop"
      },
      {
        id: 2,
        title: "Coral Bella — Privé Parfums",
        category: "perfume",
        price: 210000,
        desc: "Abre con la frescura jugosa de la pera y grosella negra, revela un corazón refinado de iris empolvado, azahar y jazmín, con estela de praliné y vainilla.",
        img: "https://images.unsplash.com/photo-1541643600914-78b084683601?w=500&auto=format&fit=crop"
      },
      {
        id: 3,
        title: "African Leopard — Amaran",
        category: "perfume",
        price: 240000,
        desc: "Abre con un destello cítrico y especiado que da paso a un corazón de cuero y maderas nobles, asentándose en un fondo resinoso de oud.",
        img: "https://images.unsplash.com/photo-1523293182086-7651a899d37f?w=500&auto=format&fit=crop"
      },
      {
        id: 4,
        title: "Black Diamond — Emper",
        category: "perfume",
        price: 220000,
        desc: "Destello cálido de jengibre y cardamomo, corazón exótico de gardenia y coco cremoso, asentado en un fondo seductor de ámbar y sándalo.",
        img: "https://images.unsplash.com/photo-1588405748880-12d1d2a59f75?w=500&auto=format&fit=crop"
      },
      {
        id: 5,
        title: "Espada Oro — Le Chameau",
        category: "perfume",
        price: 230000,
        desc: "Frescura frutal de lavanda y magnolia, corazón floral de rosa verde, jazmín y sándalo cremoso, y un fondo cálido de ámbar y almizcle.",
        img: "https://images.unsplash.com/photo-1594035910387-fea47794261f?w=500&auto=format&fit=crop"
      }
    ];

    // Cargar datos guardados o defaults
    let settings = JSON.parse(localStorage.getItem('al_settings')) || DEFAULT_SETTINGS;
    let products = JSON.parse(localStorage.getItem('al_products')) || DEFAULT_PRODUCTS;

    function renderPage() {
      // Configurar WhatsApp flotante y redes
      const waMessage = encodeURIComponent("¡Hola AURA & LUXE! Me gustaría recibir información de sus productos.");
      document.getElementById('floatingWhatsapp').href = `https://wa.me/${settings.phone}?text=${waMessage}`;
      document.getElementById('link-instagram').href = settings.instagram;
      document.getElementById('link-tiktok').href = settings.tiktok;
      document.getElementById('link-facebook').href = settings.facebook;

      // Renderizar Productos
      renderProducts(products);
    }

    function renderProducts(items) {
      const grid = document.getElementById('productGrid');
      grid.innerHTML = '';

      items.forEach(product => {
        const productMsg = encodeURIComponent(`¡Hola AURA & LUXE! Deseo pedir el producto: ${product.title} ($${product.price.toLocaleString('es-CO')} COP).`);
        const buyUrl = `https://wa.me/${settings.phone}?text=${productMsg}`;

        grid.innerHTML += `
          <div class="product-card">
            <img src="${product.img}" alt="${product.title}" class="product-img">
            <div class="product-info">
              <span class="product-category">${product.category === 'perfume' ? 'Perfumería Árabe' : 'Joyería 18K'}</span>
              <h3 class="product-title">${product.title}</h3>
              <p class="product-desc">${product.desc}</p>
              <div class="product-price">$${product.price.toLocaleString('es-CO')} COP</div>
              <a href="${buyUrl}" target="_blank" class="btn-buy">
                <i class="fa-brands fa-whatsapp"></i> Pedir por WhatsApp
              </a>
            </div>
          </div>
        `;
      });
    }

    function filterProducts(category) {
      document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
      event.target.classList.add('active');

      if (category === 'all') {
        renderProducts(products);
      } else {
        const filtered = products.filter(p => p.category === category);
        renderProducts(filtered);
      }
    }

    // Modal Admin + Clave de Seguridad Privada
    function openAdminModal() {
      const password = prompt("Ingresa la clave de administración:");
      if (password === "1234") { // CLAVE POR DEFECTO: 1234
        document.getElementById('inputPhone').value = settings.phone;
        document.getElementById('inputInsta').value = settings.instagram;
        document.getElementById('inputTikTok').value = settings.tiktok;
        document.getElementById('inputFB').value = settings.facebook;
        document.getElementById('adminModal').style.display = 'flex';
      } else if (password !== null) {
        alert("Clave incorrecta. Acceso denegado.");
      }
    }

    function closeAdminModal() {
      document.getElementById('adminModal').style.display = 'none';
    }

    function saveAdminSettings(e) {
      e.preventDefault();

      // Guardar Contactos
      settings.phone = document.getElementById('inputPhone').value;
      settings.instagram = document.getElementById('inputInsta').value;
      settings.tiktok = document.getElementById('inputTikTok').value;
      settings.facebook = document.getElementById('inputFB').value;
      localStorage.setItem('al_settings', JSON.stringify(settings));

      // Guardar Nuevo Producto si se diligenció
      const name = document.getElementById('pName').value;
      const price = document.getElementById('pPrice').value;
      const desc = document.getElementById('pDesc').value;
      const img = document.getElementById('pImg').value;
      const cat = document.getElementById('pCat').value;

      if (name && price && desc) {
        const newProduct = {
          id: Date.now(),
          title: name,
          category: cat,
          price: parseInt(price),
          desc: desc,
          img: img || "https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?w=500&auto=format&fit=crop"
        };
        products.push(newProduct);
        localStorage.setItem('al_products', JSON.stringify(products));
      }

      alert("¡Configuración guardada exitosamente!");
      closeAdminModal();
      renderPage();
    }

    // Inicializar
    renderPage();
  </script>
</body>
</html>
